#include <bits/stdc++.h>

using namespace std;

int main() {
    int n;
    bool duplicate;
    cin >> n;
    for (int i = 0; i < n; i++) {
        int size;
        cin >> size;
        int arr[size + 1];
        for (int g = 0; g < size + 1; g++) {
            cin >> arr[g];
        }
        for (int t = 0; t < size + 1; t++) {
            duplicate=false;
            for (int w = t + 1; w < size + 1; w++) {
                
                if (arr[t] == arr[w]) {
                    duplicate = true;
                    break;
                }
            }
            if (duplicate) {
                cout << arr[t]<<endl;
            }

        }
    }
}