#include <bits/stdc++.h>
using namespace std;

int main() {
    vector<vector<int>> v;
    int R,C,N;
    cin>>R>>C>>N;
    v.emplace_back(vector<int>{R,C,N});
    for (int i=0;i<N;i++){
        int r,c,val;
        cin >> r>>c>>val;
        v.emplace_back(vector<int>{r,c,val});
    }
    vector<int> count(C);
    for(int i=1;i<N+1;i++){
     count[v[i][1]]++;   
    }
    vector<int> index(C);
    for(int i=0;i<C;i++){
        if(i==0){
            index[i]=0;
        }
        else{
            index[i]=index[i-1]+count[i-1];
        }
    }
    int vout[N+1][3];
    for (int i=0;i<N+1;i++){
        if(i==0){
            vout[0][0]=v[0][1];
            vout[0][1]=v[0][0];
            vout[0][2]=v[0][2];
        }
        int a=v[i][1];
        int b=index[a];
        vout[b+1][0]=v[i][1];
        vout[b+1][1]=v[i][0];
        vout[b+1][2]=v[i][2];
        index[a]++;
    }
    for(int i =0;i<N+1;i++){
        cout<<vout[i][0]<<" "<<vout[i][1]<<" "<<vout[i][2]<<endl;
    }
}
